# pins.env — every pinned input, and nothing else. Sourced by build-llvm.sh, mirror-toolchain.sh and
# build.sh on a modern Mac and on 10.9 alike, so it runs no program and needs nothing installed
# (tests/pins-test.sh holds it to that).
# Do NOT float these: the Swift stdlib is coupled to its compiler.
# The ONE authoritative Swift pin. The tag and the toolchain URL derive from it, so a bump touches
# one line and cannot leave either behind (they used to repeat "6.3.3" four times between them).
SWIFT_VERSION="6.4.2"   # renovate: swiftlang/swift
SWIFT_TAG="swift-${SWIFT_VERSION}-RELEASE"
SWIFT_SHA="83eb12448e4323abbf81b0153dced2faff02d22f"          # commit at SWIFT_TAG; Renovate moves it with SWIFT_VERSION
# The SHA-256 of GitHub's tarball of each pinned commit: the builds fetch the sources as tarballs, with no
# git (OS X 10.9 has none without Xcode's Command Line Tools), and verify them by it. Renovate cannot
# compute a hash, so a Swift bump's PR runs scripts/pin-source-tarballs.sh, which writes these three.
SWIFT_TARBALL_SHA256="88b6293a8d23a46bc27ca9f4a71a9c6398a95cbf145b9c61eb4860daa1019ca9"
# llvm-project tags every Swift release with the same swift-X.Y.Z-RELEASE name, so the LLVM pin is
# that tag. Its release is a second literal, not derived from SWIFT_VERSION, only because Renovate
# needs a value of its own to move LLVM_SHA by; build-llvm.sh fails unless the two are equal and
# LLVM_SHA is the commit at LLVM_TAG. .github/renovate.json groups the two into one PR.
LLVM_SWIFT_RELEASE="6.4.2"   # renovate: swiftlang/llvm-project
LLVM_TAG="swift-${LLVM_SWIFT_RELEASE}-RELEASE"
LLVM_SHA="fb5f84d903a3b4e7aea15cd5666598a46f56c833"           # commit at LLVM_TAG; Renovate moves it with LLVM_SWIFT_RELEASE
LLVM_TARBALL_SHA256="76d1d9a01297c55360ccbc585236f5436688f359977a60b7ae39b5f7c63d02a3"
# swift-cmark (the compiler's Markdown parser) is tagged per Swift release exactly like llvm-project,
# and pinned the same way for the same reason; build-toolchain.sh runs check_release_pin on it.
CMARK_SWIFT_RELEASE="6.4.2"   # renovate: swiftlang/swift-cmark
CMARK_TAG="swift-${CMARK_SWIFT_RELEASE}-RELEASE"
CMARK_SHA="924936d0427cb25a61169739a7660230bffa6ea6"          # commit at CMARK_TAG; Renovate moves it with CMARK_SWIFT_RELEASE
CMARK_TARBALL_SHA256="1c51659bd47c34df1c8976f893adc43ba039a98f6eac4fa95d53d1e08ba6072a"
# The C/C++ compiler for the 10.9-hosted toolchain: mavericks-clang-22's CROSS toolchain (arm64 host,
# default target x86_64-apple-macos10.9, static gap-filling libc++). fetch-clang22.sh verifies the
# release's pkg against that release's own SHA256SUMS, so this one line is the whole pin.
CLANG22_VERSION="22.1.8-mavericks.7"   # renovate: github-releases Mavergreen/clang-22
# Recaulk, the family's back-fills of post-10.9 OS APIs: libswiftCore links the few definitions
# build.sh's RECAULK_RUNTIME_SYMBOLS names, statically, out of librecaulk.a. fetch-recaulk.sh verifies the
# release's pkg against that release's own SHA256SUMS, so this one line is the whole pin.
RECAULK_VERSION="20261108.3"   # renovate: github-releases Mavergreen/recaulk
# FROZEN overlay sources, outside every automatic updater. Swift 6.3 deleted stdlib/public/Platform (the Darwin
# overlay's sources) and 5.5 deleted stdlib/public/Darwin/ObjectiveC, so Mavergreen owns these two old trees: the
# builds fetch GitHub's tarball of each commit (lib.sh's fetch_source, from $SWIFT_REPO_URL) into swift-6.2 and
# swift-5.4, verified by the SHA-256. Nothing moves them: no "renovate:" marker, no Renovate pattern matches
# the SWIFT62_/SWIFT54_ names, and the pins bot and scripts/pin-source-tarballs.sh list only the three
# live *_TARBALL_SHA256 keys (tests/pins-test.sh holds all three to it). A bump is a deliberate edit.
SWIFT62_SHA="1ff1cc1170617ab23ab74aa8b741c8daca1903f6"        # commit at swift-6.2-RELEASE
SWIFT62_TARBALL_SHA256="815d70be2fcc5a0a9afc15a31c91838be514654f06bba812a8ca378584c0e480"
SWIFT54_SHA="3e4fab9bb6a56fc30d43e72eaff5b096cf160c55"        # commit at swift-5.4-RELEASE
SWIFT54_TARBALL_SHA256="186c07fed22ea082153eda07f7533208914aaa48c30a7086c9162f2f78cf19f9"
TOOLCHAIN_URL="https://download.swift.org/swift-${SWIFT_VERSION}-release/xcode/${SWIFT_TAG}/${SWIFT_TAG}-osx.pkg"
# The toolchain .pkg is verified by its SIGNATURE, not by a pinned hash. A hash can only vouch for
# bytes someone has already seen, so every version bump needed a human to paste a new one -- the one
# thing keeping Swift updates off the automated path. The signing identity is stable across releases,
# so this verifies a version that does not exist yet. Upstream publishes no GPG .sig for the macOS
# .pkg (that URL 404s); the .pkg is an Apple-signed installer, so pkgutil is the check that exists.
TOOLCHAIN_SIGNER="Developer ID Installer: Swift Open Source (V9AUD2URP3)"
DEPLOYMENT="10.9"
ARCH="x86_64"

# Mirrored, not built: keeps upstream's filename so the correspondence with download.swift.org stays
# checkable, prefixed to make its nature obvious. Attached to -mavericks.1 releases only.
TOOLCHAIN_ASSET="upstream-swift-$SWIFT_VERSION-RELEASE-osx.pkg"
