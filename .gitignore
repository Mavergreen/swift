# Never commit Apple SDK/toolchain bytes, built binaries, or packages.
*.dylib
*.pkg
*.tar.gz
.build/
# macOS + tooling cruft
._*
.DS_Store
.superpowers/
docs/
/VERSION
/UPSTREAM_VERSION

# The build root is $MAVERICKS_BUILD_ROOT/swift (outside the tree, see lib.sh). These are only the
# deliberate in-tree escape hatch (MAVERICKS_BUILD_ROOT="$PWD" ./build.sh) and the relative build
# dirs the scripts name (build-llvm.sh configures `-B llvm-build` inside its work dir).
/swift/
work/
out/
dist/
llvm-build/
/.idea/
