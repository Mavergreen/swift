# tests/upstream/objectivec.list -- upstream Swift's own tests for the objectivec layer, as the 10.9 gate runs them.
# Every candidate scripts/upstream-tests.py's survey finds in the pinned tree (a test with a RUN: line that
# the objectivec classifier picks) appears once: `include <path>`, built by make-selftest.sh with its
# compile-line and run by run-selftest.sh --gate, or `exclude <path> -- <reason>`, a reason a reviewer
# can check against the test (it imports Foundation, which no 10.9 pkg ships; it needs a library this
# release does not ship; its RUN: line is one compile-line refuses, quoted as it says; upstream disables
# it; it is a Concurrency test, which tests/upstream/concurrency.list decides, so it is built once; or it
# failed on 10.9, with the failure). build.sh's step 5b checks this list against the tree, so a
# Swift bump that adds a test, or gives an included one a RUN: form, compiler flag or REQUIRES:/UNSUPPORTED:
# the script does not know, stops the build until the list is reviewed (a changed source does not; the gate runs it).
exclude test/Concurrency/Runtime/actor_dynamic_subclass.swift -- a Concurrency test: tests/upstream/concurrency.list decides it
exclude test/Concurrency/Runtime/actor_init_abi.swift -- a Concurrency test: tests/upstream/concurrency.list decides it
exclude test/Concurrency/Runtime/async_task_executor_nsobject.swift -- a Concurrency test: tests/upstream/concurrency.list decides it
exclude test/Concurrency/Runtime/objc_async.swift -- a Concurrency test: tests/upstream/concurrency.list decides it
exclude test/stdlib/ArrayBridge.swift.gyb -- imports Foundation, which no 10.9 pkg ships
include test/stdlib/AutoreleasingUnsafeMutablePointer.swift
exclude test/stdlib/AutoreleasingUnsafeMutablePointerDiagnostics.swift -- RUN uses %target-typecheck-verify-swift
exclude test/stdlib/AutoreleasingUnsafeMutablePointerDiagnostics_warning.swift -- RUN uses %target-typecheck-verify-swift
exclude test/stdlib/BridgeEquatableToObjC.swift -- imports Foundation, which no 10.9 pkg ships
exclude test/stdlib/BridgeIdAsAny.swift.gyb -- imports Foundation, which no 10.9 pkg ships
exclude test/stdlib/BridgeNonVerbatim.swift -- imports Foundation, which no 10.9 pkg ships
exclude test/stdlib/BridgeStorage.swift -- imports Foundation, which no 10.9 pkg ships
