+// Mavericks: Foundation-free StdlibUnittest (MAVERICKS_NO_FOUNDATION). No
+// Foundation ships for OS X 10.9, and the harness's weak reference to
+// Optional<Foundation.Locale> fails to resolve there, aborting every test.
+// This reads the same SystemVersion.plist the Foundation path reads, with
+// POSIX calls, scanning its XML for <key>NAME</key> ... <string>VALUE</string>;
+// the sysctl fallback below reads kern.osproductversion, which is macOS
+// 10.13.4 and later, and reports nothing on 10.9.
+func _getSystemVersionPlistProperty(_ propertyName: String) -> String? {
+  let fd = open("/System/Library/CoreServices/SystemVersion.plist", O_RDONLY)
+  if fd < 0 { return nil }
+  defer { _ = close(fd) }
+  var bytes = [UInt8]()
+  var chunk = [UInt8](repeating: 0, count: 8192)
+  while true {
+    let n = chunk.withUnsafeMutableBytes { read(fd, $0.baseAddress, $0.count) }
+    if n <= 0 { break }
+    bytes.append(contentsOf: chunk[0..<n])
+  }
+  // Byte-level substring search (avoids Foundation's String.range(of:)).
+  func find(_ needle: [UInt8], from start: Int) -> Int? {
+    if needle.isEmpty || bytes.count < needle.count { return nil }
+    var i = start
+    let last = bytes.count - needle.count
+    while i <= last {
+      var j = 0
+      while j < needle.count && bytes[i + j] == needle[j] { j += 1 }
+      if j == needle.count { return i }
+      i += 1
+    }
+    return nil
+  }
+  let keyTag = Array("<key>\(propertyName)</key>".utf8)
+  let sOpen = Array("<string>".utf8), sClose = Array("</string>".utf8)
+  guard let k = find(keyTag, from: 0),
+        let vs = find(sOpen, from: k + keyTag.count),
+        let ve = find(sClose, from: vs + sOpen.count) else { return nil }
+  return String(decoding: bytes[(vs + sOpen.count)..<ve], as: UTF8.self)
+}
