+#if SWIFT_OBJC_INTEROP
+#include <dlfcn.h>
+// Mavericks 10.9: whether libobjc itself lacks objc_readClassPair (10.9 and 10.10),
+// which is what leaves a runtime-realized class's ivars unslid. Asked of libobjc by
+// name, never of the weak import or RTLD_DEFAULT: a definition from elsewhere (a
+// back-fill linked into this image or into the program) realizes the class without
+// sliding its ivars either.
+static bool mav_libobjcLacksReadClassPair() {
+  void *objc = dlopen("/usr/lib/libobjc.A.dylib", RTLD_LAZY | RTLD_NOLOAD);
+  bool lacks = !objc || !dlsym(objc, "objc_readClassPair");
+  if (objc)
+    dlclose(objc);
+  return lacks;
 }
+#endif
 
 static void initClassFieldOffsetVector(ClassMetadata *self,
