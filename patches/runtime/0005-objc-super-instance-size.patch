@@ -4100,6 +4116,23 @@
     } else {
       size = rodata->InstanceStart;
       alignMask = 0xF; // malloc alignment guarantee
+
+      // Mavericks 10.9: objc4-532 eager-realizes static Swift classes at image
+      // load, after which their is-swift bit is not observed, so an
+      // actually-Swift superclass lands here (superIsTypeMetadata==0) instead of
+      // the Swift branch above. rodata->InstanceStart is only a placeholder start
+      // (e.g. 16), and nothing slides it on 10.9 (libobjc has no objc_readClassPair,
+      // and Recaulk's realization doesn't reconcile ivars) -> the subclass ends
+      // up smaller than its superclass and its instances overrun the heap. The
+      // superclass's TRUE size is its realized objc instanceSize; start from that.
+      // Gated to a libobjc without readClassPair (10.9/10.10) so the modern path
+      // -- where objc performs the slide itself -- is unchanged.
+      if (SWIFT_LAZY_CONSTANT(mav_libobjcLacksReadClassPair())) {
+        size_t superObjCSize =
+            (size_t)class_getInstanceSize((Class)const_cast<ClassMetadata *>(super));
+        if (superObjCSize > size)
+          size = superObjCSize;
+      }
     }
 #endif
 
