@@ -9410,6 +9410,13 @@
   if (isa<MacroExpansionExpr>(init))
     return DefaultArgumentKind::ExpressionMacro;
 
+  // Mavergreen: #isolation is the caller's, without swift-syntax too. A compiler built without it
