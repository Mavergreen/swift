+// Mavergreen: the 10.9 runtime is the pkgs'. A client built for a macOS older
+// than 10.14.4, the first with a Swift runtime of its own, records
+// @rpath/libswiftCore.dylib (Core's $ld$previous), and on a Mavergreen OS X 10.9
+// loads the Swift runtime the swift-runtime pkg ships (6.4). For such a target
+// every released Swift version (upstream's table, short of FUTURE) is therefore
+// available from 10.9 on. From 10.14.4 a client loads the OS's
+// /usr/lib/swift, and upstream's table holds exactly. What the OS's libobjc
+// provides is never the pkgs': isOSRuntimeFeature()'s features, and the callers
+// that ask getOSSwiftAvailability() themselves, keep upstream's table on every
+// target. Every feature's class: patches/compiler/0003-AUDIT.md.
+static bool isMacOSTargetBeforeSwiftInTheOS(const llvm::Triple &target) {
+  return target.isMacOSX() && target.isMacOSXVersionLT(10, 14, 4);
+}
+
+bool ASTContext::isOSRuntimeFeature(StringRef feature) {
+  return llvm::StringSwitch<bool>(feature)
+      .Case("ObjCMetadataUpdateCallback", true) // _objc_realizeClassFromSwift
+      .Case("ObjCGetClassHook", true)           // objc_setHook_getClass
+      .Case("ObjCClassStubs", true)             // objc_loadClassref
+      .Case("ObjCIsUniquelyReferenced", true)   // objc_isUniquelyReferenced
+      .Default(false);
+}
+
+// Mavergreen: the 10.9 runtime is the pkgs'. The same split, for declarations.
+// Below 10.14.4 a client loads the Swift code the runtime pkg ships for these
+// modules, all of it 6.4's, so a declaration of theirs introduced on macOS with
+// a released Swift runtime (a macOS version of upstream's table, short of
+// FUTURE) is available from 10.9; Swift's own @available macros stay upstream's,
+// so a module built with them serves every target. Darwin and ObjectiveC are not
+// among them: their availability is the OS's APIs'. Span's types are: Core's
+// $ld$previous sends their symbols to @rpath/libswiftCompatibilitySpan.dylib,
+// which the runtime pkg ships as a link to libswiftCore.dylib, as upstream's
+// stdlib install does. From 10.14.4: upstream's. Unavailable, obsoleted and
+// deprecated versions are never moved.
+bool ASTContext::isPkgsRuntimeModule(StringRef module) {
+  return llvm::StringSwitch<bool>(module)
+      .Case("Swift", true)
+      .Case("_Concurrency", true)
+      .Case("SwiftOnoneSupport", true)
+      .Case("_Builtin_float", true)
+      .Default(false);
+}
+
+std::optional<llvm::VersionTuple>
+ASTContext::getPkgsRuntimeIntroduced(StringRef module,
+                                     llvm::VersionTuple macOSIntroduced) const {
+  if (!isMacOSTargetBeforeSwiftInTheOS(LangOpts.Target) ||
+      !isPkgsRuntimeModule(module))
+    return std::nullopt;
+  auto introduced =
+      canonicalizePlatformVersion(PlatformKind::macOS, macOSIntroduced);
+#define RUNTIME_VERSION(V, PLATFORMS) PLATFORMS
+#define PLATFORM(P, V) PLATFORM_##P(V)
+#define PLATFORM_macOS(V)                                                      \
+  if (introduced ==                                                            \
+      canonicalizePlatformVersion(PlatformKind::macOS, llvm::VersionTuple V))  \
+    return llvm::VersionTuple(10, 9, 0);
+#define PLATFORM_iOS(V)
+#define PLATFORM_watchOS(V)
+#define PLATFORM_visionOS(V)
+#include "swift/AST/RuntimeVersions.def"
+#undef PLATFORM_macOS
+#undef PLATFORM_iOS
+#undef PLATFORM_watchOS
+#undef PLATFORM_visionOS
+  return std::nullopt;
+}
+
 AvailabilityRange ASTContext::getSwiftAvailability(unsigned major,
                                                    unsigned minor) const {
+  auto upstream = getOSSwiftAvailability(major, minor);
+  if (isMacOSTargetBeforeSwiftInTheOS(LangOpts.Target) &&
+      upstream.hasMinimumVersion() &&
+      upstream.getRawMinimumVersion() < llvm::VersionTuple(99, 99))
+    return AvailabilityRange(VersionRange::allGTE(llvm::VersionTuple(10, 9, 0)));
+  return upstream;
+}
