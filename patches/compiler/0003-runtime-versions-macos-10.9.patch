+// Mavergreen: the 10.9 runtime is the pkgs'. A client built for a macOS older
+// than 10.14.4, the first with a Swift runtime of its own, records
+// @rpath/libswiftCore.dylib (Core's $ld$previous), and on a Mavergreen OS X 10.9
+// loads the Swift runtime the swift-runtime pkg ships (6.4). For such a target
+// every released Swift version (upstream's table, short of FUTURE) is therefore
+// available from 10.9 on. From 10.14.4 a client loads the OS's
+// /usr/lib/swift, and upstream's table holds exactly. What the OS's libobjc
+// provides is never the pkgs': isOSRuntimeFeature()'s features, and the callers
+// that ask getOSSwiftAvailability() themselves, keep upstream's table on every
+// target. Every feature's class: patches/compiler/0003-AUDIT.md.
+static bool isMacOSTargetBeforeSwiftInTheOS(const llvm::Triple &target) {
+  return target.isMacOSX() && target.isMacOSXVersionLT(10, 14, 4);
+}
+
+bool ASTContext::isOSRuntimeFeature(StringRef feature) {
+  return llvm::StringSwitch<bool>(feature)
+      .Case("ObjCMetadataUpdateCallback", true) // _objc_realizeClassFromSwift
+      .Case("ObjCGetClassHook", true)           // objc_setHook_getClass
+      .Case("ObjCClassStubs", true)             // objc_loadClassref
+      .Case("ObjCIsUniquelyReferenced", true)   // objc_isUniquelyReferenced
+      .Default(false);
+}
+
 AvailabilityRange ASTContext::getSwiftAvailability(unsigned major,
                                                    unsigned minor) const {
+  auto upstream = getOSSwiftAvailability(major, minor);
+  if (isMacOSTargetBeforeSwiftInTheOS(LangOpts.Target) &&
+      upstream.hasMinimumVersion() &&
+      upstream.getRawMinimumVersion() < llvm::VersionTuple(99, 99))
+    return AvailabilityRange(VersionRange::allGTE(llvm::VersionTuple(10, 9, 0)));
+  return upstream;
+}
