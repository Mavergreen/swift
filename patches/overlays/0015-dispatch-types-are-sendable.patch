+// Mavericks: 5.4 predates Sendable. A Swift 6 client captures a queue, a group or a semaphore in the
+// @Sendable closures it hands the queue, and passes a time, a QoS or a flag set across them, as Apple's
+// SDK lets it: Sendable exactly where Apple's newest SDK declares it, and nowhere else (not
+// DispatchWorkItem, nor a source's event flags). The objects are thread-safe and the values plain
+// data (@unchecked, as a retroactive conformance of another file's type must be).
+extension DispatchObject : @unchecked Sendable {}
+extension DispatchSpecificKey : @unchecked Sendable where T : Sendable {}
+extension DispatchData : @unchecked Sendable {}
+extension DispatchDataIterator : @unchecked Sendable {}
+extension DispatchTime : @unchecked Sendable {}
+extension DispatchWallTime : @unchecked Sendable {}
+extension DispatchTimeInterval : @unchecked Sendable {}
+extension DispatchTimeoutResult : @unchecked Sendable {}
+extension DispatchQoS : @unchecked Sendable {}
+extension DispatchQoS.QoSClass : @unchecked Sendable {}
+extension DispatchWorkItemFlags : @unchecked Sendable {}
+extension DispatchQueue.Attributes : @unchecked Sendable {}
+extension DispatchIO.StreamType : @unchecked Sendable {}
+extension DispatchIO.CloseFlags : @unchecked Sendable {}
+extension DispatchIO.IntervalFlags : @unchecked Sendable {}
